# ============================================
# .gitignore: projekt Budowa pojazdów drogowych
# ============================================

# --- Obsidian (ustawienia i cache lokalne) ---
.obsidian/
.trash/

# --- Pliki systemowe (Windows, macOS) ---
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Pliki tymczasowe pakietów biurowych ---
# Word, Excel, PowerPoint (blokady otwartych plików)
~$*
# LibreOffice / OpenOffice
.~lock.*#
# Pliki tymczasowe i kopie zapasowe
*.tmp
*.temp
*.bak
*.swp
*~

# --- Edytory i IDE ---
.vscode/
.idea/

# --- Python (obliczenia, skrypty, notebooki) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# --- MATLAB / Simulink ---
*.asv
*.autosave
slprj/
*.slxc

# --- Katalogi robocze ---
tmp/
temp/

# --- Wrażliwe dane lokalne (na wszelki wypadek) ---
.env
*.key
